[Version]
Signature   = "$Windows NT$"
Class       = MEDIA
Provider    = %ProviderName%
ClassGUID   = {4d36e96c-e325-11ce-bfc1-08002be10318}
DriverVer   = 02/22/2016, 1.0.0.1
CatalogFile = virtuacam-mic.cat
PnpLockDown = 1

[SourceDisksNames]
222="VirtuaCamMic Driver Disk","",222

[SourceDisksFiles]
virtuacam_mic.sys=222

[Manufacturer]
%MfgName%=VirtuaCamMic,NTamd64

[VirtuaCamMic.NTamd64]
%VirtuaCamMic_SA.DeviceDesc%=VirtuaCamMic_SA, ROOT\VIRTUACAMMIC

[DestinationDirs]
VirtuaCamMic_SA.CopyList=13 ; 13=Package's DriverStore directory

;======================================================
; VirtuaCamMic_SA
;======================================================
[VirtuaCamMic_SA.CopyList]
virtuacam_mic.sys

[VirtuaCamMic_SA.AddReg]
HKR,,AssociatedFilters,,"wdmaud,swmidi,redbook"
HKR,,Driver,,virtuacam_mic.sys

;
; For demo only, please review these power management settings for your architecture. 
;
HKR,PowerSettings,SingleComponentMultiFxStates,3,1,0,0,0  ; Turn on multi Fx support.
HKR,PowerSettings,ConservationIdleTime,3,3,0,0,0          ; 3 seconds for idle power management when on battery
HKR,PowerSettings,PerformanceIdleTime,3,3,0,0,0           ; 3 seconds for idle power management when on AC power
HKR,PowerSettings,IdlePowerState,3,3,0,0,0                ; go to D3 for idle power management

HKR,Drivers,SubClasses,,"wave,midi,mixer"

HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\midi\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv

HKR,Drivers\wave\wdmaud.drv,Description,,%VirtuaCamMic_SA.DeviceDesc%
HKR,Drivers\mixer\wdmaud.drv,Description,,%VirtuaCamMic_SA.DeviceDesc%

;======================================================
; capture interfaces: mic array (internal: front)
;======================================================
[VirtuaCamMic.I.WaveMicArray1]
AddReg=VirtuaCamMic.I.WaveMicArray1.AddReg
[VirtuaCamMic.I.WaveMicArray1.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%VirtuaCamMic.WaveMicArray1.szPname%

[VirtuaCamMic.I.TopologyMicArray1]
AddReg=VirtuaCamMic.I.TopologyMicArray1.AddReg

[VirtuaCamMic.I.TopologyMicArray1.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%VirtuaCamMic.TopologyMicArray1.szPname%

HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%

; The following lines opt-in to pull mode.
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,0x1

;======================================================
; VirtuaCamMic_SA
;======================================================
[VirtuaCamMic_SA.NT]
Include=ks.inf,wdmaudio.inf
Needs=KS.Registration, WDMAUDIO.Registration
CopyFiles=VirtuaCamMic_SA.CopyList
AddReg=VirtuaCamMic_SA.AddReg

[VirtuaCamMic_SA.NT.Interfaces]
;
; Interfaces for microphone array 1 (internal: front) capture endpoint.
;
AddInterface=%KSCATEGORY_AUDIO%,    %KSNAME_WaveMicArray1%, VirtuaCamMic.I.WaveMicArray1
AddInterface=%KSCATEGORY_REALTIME%, %KSNAME_WaveMicArray1%, VirtuaCamMic.I.WaveMicArray1
AddInterface=%KSCATEGORY_CAPTURE%,  %KSNAME_WaveMicArray1%, VirtuaCamMic.I.WaveMicArray1
AddInterface=%KSCATEGORY_AUDIO%,    %KSNAME_TopologyMicArray1%, VirtuaCamMic.I.TopologyMicArray1
AddInterface=%KSCATEGORY_TOPOLOGY%, %KSNAME_TopologyMicArray1%, VirtuaCamMic.I.TopologyMicArray1

[VirtuaCamMic_SA.NT.Services]
AddService=VirtuaCamMic,0x00000002,VirtuaCamMic_Service_Inst

[VirtuaCamMic_Service_Inst]
DisplayName=%VirtuaCamMic.SvcDesc%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\virtuacam_mic.sys

[VirtuaCamMic_SA.NT.HW]
AddReg = AUDIOHW.AddReg

[AUDIOHW.AddReg]
; FILE_DEVICE_SOUND
HKR,,DeviceType,0x10001,0x0000001D
; SDDL_DEVOBJ_SYS_ALL_ADM_RWX_WORLD_RWX_RES_RWX
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GRGWGX;;;BA)(A;;GRGWGX;;;WD)(A;;GRGWGX;;;RC)"

;======================================================
; COMMON
;======================================================
[Strings]

;Non-localizable

KSNAME_WaveSpeaker="WaveSpeaker"
KSNAME_TopologySpeaker="TopologySpeaker"

KSNAME_WaveMicArray1="WaveMicArray1"
KSNAME_TopologyMicArray1="TopologyMicArray1"

Proxy.CLSID="{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
KSCATEGORY_AUDIO="{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_CAPTURE="{65E8773D-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_REALTIME ="{EB115FFC-10C8-4964-831D-6DCB02E6F23F}"
KSCATEGORY_TOPOLOGY = "{DDA54A40-1E4C-11D1-A050-405705C10000}"

KSNODETYPE_ANY   = "{00000000-0000-0000-0000-000000000000}"

PKEY_AudioEndpoint_Association               = "{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},2"
PKEY_AudioEndpoint_Supports_EventDriven_Mode = "{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},7"

;Localizable

ProviderName = "VirtuaCam"
MfgName      = "VirtuaCam"
MsCopyRight  = "VirtuaCam"

VIRTUACAMMIC_SA.DeviceDesc="VirtuaCam Microphone"
VirtuaCamMic.SvcDesc="VirtuaCam Microphone Driver"

;; friendly names

VIRTUACAMMIC.WaveMicArray1.szPname="VirtuaCam Microphone Wave"
VIRTUACAMMIC.TopologyMicArray1.szPname="VirtuaCam Microphone Topology"

MicArray1CustomName= "VirtuaCam Microphone"


